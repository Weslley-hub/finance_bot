generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  LOAN
}

enum TransactionSource {
  TEXT
  PHOTO
  PDF
  MANUAL
  IMPORT
}

enum TransactionPermission {
  ALL_MEMBERS
  ADMINS_ONLY
  SELECTED_MEMBERS
}

enum CategorizationSource {
  RULE
  HISTORY
  AI
  MANUAL
}

model Family {
  id                    String                 @id @default(uuid())
  name                  String
  telegramChatId        String                 @unique @map("telegram_chat_id")
  transactionPermission TransactionPermission  @default(SELECTED_MEMBERS) @map("transaction_permission")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  users            User[]
  categoryRules    CategoryRule[]
  transactions     Transaction[]
  transactionHistory TransactionHistory[]
  documents        Document[]
  bills            Bill[]
  recurringBills   RecurringBill[]
  accounts         Account[]
  cards            Card[]
  installmentPlans InstallmentPlan[]
  budgets          Budget[]
  monthlyGoal      MonthlyGoal?
  cardInvoices     CardInvoice[]
  allowedChats     AllowedTelegramChat[]

  @@map("families")
}

model AllowedTelegramChat {
  id        String   @id @default(uuid())
  chatId    String   @unique @map("chat_id")
  label     String?
  familyId  String?  @map("family_id")
  createdAt DateTime @default(now()) @map("created_at")

  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@map("allowed_telegram_chats")
}

model User {
  id             String   @id @default(uuid())
  telegramUserId String   @unique @map("telegram_user_id")
  name           String
  username       String?
  familyId       String?  @map("family_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  family         Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  transactionChanges TransactionHistory[] @relation("HistoryChangedBy")
  documents      Document[]
  bills          Bill[]
  recurringBills RecurringBill[]
  installmentPlans InstallmentPlan[]

  @@index([familyId])
  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  emoji     String
  parentId  String?  @map("parent_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent                 Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children               Category[]     @relation("CategoryTree")
  rules                  CategoryRule[]
  transactions           Transaction[]  @relation("TransactionCategory")
  transactionsAsSub      Transaction[]  @relation("TransactionSubcategory")
  bills                  Bill[]
  recurringBills         RecurringBill[]
  installmentPlans       InstallmentPlan[]
  budgets                Budget[]

  @@index([parentId])
  @@map("categories")
}

model CategoryRule {
  id         String   @id @default(uuid())
  familyId   String?  @map("family_id")
  pattern    String
  merchant   String?
  categoryId String   @map("category_id")
  confidence Float    @default(0.9)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  family   Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([familyId])
  @@index([categoryId])
  @@map("category_rules")
}

model Account {
  id        String   @id @default(uuid())
  familyId  String   @map("family_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([familyId, name])
  @@index([familyId])
  @@map("accounts")
}

model Transaction {
  id                   String               @id @default(uuid())
  familyId             String               @map("family_id")
  /// createdBy — quem registrou a transação no grupo
  userId               String               @map("user_id")
  type                 TransactionType
  amount               Decimal              @db.Decimal(12, 2)
  description          String
  merchant             String?
  rawText              String?              @map("raw_text")
  categoryId           String               @map("category_id")
  subcategoryId        String?              @map("subcategory_id")
  accountId            String?              @map("account_id")
  creditCardId         String?              @map("credit_card_id")
  transactionDate      DateTime             @map("transaction_date")
  source               TransactionSource
  sourceDocumentId     String?              @map("source_document_id")
  categorizationSource CategorizationSource @map("categorization_source")
  confidence           Float                @default(0)
  cardInvoiceId        String?              @map("card_invoice_id")
  deletedAt            DateTime?            @map("deleted_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  family         Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  category       Category      @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory    Category?     @relation("TransactionSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard     Card?         @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  sourceDocument Document?     @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  billSettlement Bill?
  installment    Installment?
  cardInvoice    CardInvoice?  @relation(fields: [cardInvoiceId], references: [id], onDelete: SetNull)
  history        TransactionHistory[]

  @@index([familyId])
  @@index([userId])
  @@index([merchant])
  @@index([transactionDate])
  @@index([createdAt])
  @@index([creditCardId])
  @@index([cardInvoiceId])
  @@index([accountId])
  @@index([sourceDocumentId])
  @@index([subcategoryId])
  @@index([deletedAt])
  @@map("transactions")
}

enum TransactionHistoryAction {
  CREATED
  UPDATED
  DELETED
}

model TransactionHistory {
  id            String                    @id @default(uuid())
  transactionId String                    @map("transaction_id")
  familyId      String                    @map("family_id")
  changedById   String                    @map("changed_by_id")
  action        TransactionHistoryAction
  previousValue Json?                     @map("previous_value")
  newValue      Json?                     @map("new_value")
  createdAt     DateTime                  @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("HistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([familyId])
  @@index([changedById])
  @@index([createdAt])
  @@map("transaction_history")
}

enum DocumentType {
  RECEIPT
  BANK_RECEIPT
  BILL
  INVOICE
  BANK_STATEMENT
  UNKNOWN
}

enum DocumentStatus {
  PENDING
  PROCESSED
  REVIEW
  FAILED
}

enum BillStatus {
  PENDING
  PAID
  CANCELLED
}

enum RecurringFrequency {
  MONTHLY
}

model RecurringBill {
  id         String              @id @default(uuid())
  familyId   String              @map("family_id")
  userId     String              @map("user_id")
  categoryId String              @map("category_id")
  supplier   String
  amount     Decimal             @db.Decimal(12, 2)
  dayOfMonth Int                 @map("day_of_month")
  frequency  RecurringFrequency  @default(MONTHLY)
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bills    Bill[]

  @@index([familyId, active])
  @@map("recurring_bills")
}

model Document {
  id             String         @id @default(uuid())
  familyId       String         @map("family_id")
  userId         String         @map("user_id")
  telegramFileId String         @map("telegram_file_id")
  type           DocumentType
  storagePath    String?        @map("storage_path")
  extractedText  String?        @map("extracted_text") @db.Text
  parsedData     Json?          @map("parsed_data")
  status         DocumentStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  bills        Bill[]
  transactions Transaction[]

  @@index([familyId])
  @@index([familyId, type])
  @@index([status])
  @@map("documents")
}

model Bill {
  id                String     @id @default(uuid())
  familyId          String     @map("family_id")
  userId            String     @map("user_id")
  categoryId        String     @map("category_id")
  supplier          String
  amount            Decimal    @db.Decimal(12, 2)
  dueDate           DateTime?  @map("due_date")
  barcode           String?
  status            BillStatus @default(PENDING)
  referenceMonth    Int        @map("reference_month")
  referenceYear     Int        @map("reference_year")
  documentId        String?    @map("document_id")
  paidTransactionId String?    @unique @map("paid_transaction_id")
  recurringBillId   String?    @map("recurring_bill_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  family          Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  document        Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  paidTransaction Transaction?   @relation(fields: [paidTransactionId], references: [id], onDelete: SetNull)
  recurringBill   RecurringBill? @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)

  @@unique([recurringBillId, referenceMonth, referenceYear])
  @@index([familyId, status])
  @@index([dueDate])
  @@map("bills")
}

enum InstallmentStatus {
  PENDING
  PAID
  CANCELLED
}

model Card {
  id          String   @id @default(uuid())
  familyId    String   @map("family_id")
  name        String
  creditLimit Decimal? @map("credit_limit") @db.Decimal(12, 2)
  usedAmount  Decimal  @default(0) @map("used_amount") @db.Decimal(12, 2)
  closingDay  Int?     @map("closing_day")
  dueDay      Int?     @map("due_day")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  plans        InstallmentPlan[]
  invoices     CardInvoice[]
  transactions Transaction[]

  @@unique([familyId, name])
  @@map("cards")
}

model CardInvoice {
  id             String     @id @default(uuid())
  familyId       String     @map("family_id")
  cardId         String     @map("card_id")
  referenceMonth Int        @map("reference_month")
  referenceYear  Int        @map("reference_year")
  closingDate    DateTime   @map("closing_date")
  dueDate        DateTime   @map("due_date")
  status         BillStatus @default(PENDING)
  amount         Decimal    @db.Decimal(12, 2) @default(0)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  card         Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([cardId, referenceMonth, referenceYear])
  @@index([familyId, status])
  @@map("card_invoices")
}

model InstallmentPlan {
  id                 String                @id @default(uuid())
  familyId           String                @map("family_id")
  userId             String                @map("user_id")
  cardId             String?               @map("card_id")
  categoryId         String                @map("category_id")
  description        String
  merchant           String?
  rawText            String?               @map("raw_text")
  totalAmount        Decimal               @db.Decimal(12, 2) @map("total_amount")
  installmentCount   Int                   @map("installment_count")
  installmentAmount  Decimal               @db.Decimal(12, 2) @map("installment_amount")
  source             CategorizationSource
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  card         Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installments Installment[]

  @@index([familyId])
  @@map("installment_plans")
}

model Installment {
  id             String             @id @default(uuid())
  planId         String             @map("plan_id")
  number         Int
  amount         Decimal            @db.Decimal(12, 2)
  referenceMonth Int                @map("reference_month")
  referenceYear  Int                @map("reference_year")
  dueDate        DateTime?          @map("due_date")
  status         InstallmentStatus  @default(PENDING)
  transactionId  String?            @unique @map("transaction_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  plan        InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  transaction Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([planId, number])
  @@index([referenceYear, referenceMonth, status])
  @@map("installments")
}

model Budget {
  id         String   @id @default(uuid())
  familyId   String   @map("family_id")
  categoryId String   @map("category_id")
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([familyId, categoryId])
  @@index([familyId])
  @@map("budgets")
}

model MonthlyGoal {
  id        String   @id @default(uuid())
  familyId  String   @unique @map("family_id")
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("monthly_goals")
}


